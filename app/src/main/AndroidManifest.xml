<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗：屏幕 RGB 光效覆盖层 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 马达震动：跟随节拍 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 麦克风回退：无播放器频谱时拾取环境声音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 前台服务持有光效与音频可视化 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+ 前台服务通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 渲染线程唤醒 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 11+ 包可见性：声明可查询的启动器应用，供"选择触发应用/推荐Hook"界面列出全部应用 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RGBBeat">

        <!-- ============ LSPosed 模块声明（LSPosed 通过以下 metadata 识别本模块） ============ -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="乘车晕车缓解与音乐律动增强：自动识别打车/导航应用或车辆运动，开启屏幕边缘晕车缓解光效并提示；融合音乐节拍光效与马达震动" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!-- 推荐作用域：LSPosed 据此在作用域页把数组内的应用标为"推荐应用"并自动勾选 -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AboutActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- 触发应用选择界面（小窗） -->
        <activity
            android:name=".ui.AppPickActivity"
            android:exported="false"
            android:theme="@style/Theme.RGBBeat.Dialog" />

        <!-- 无障碍触发服务：监听前台应用，命中选中的应用时自动开启光效（需用户在系统无障碍设置中开启） -->
        <service
            android:name=".core.AppTriggerService"
            android:exported="true"
            android:label="@string/trigger_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 前台服务：导出以便 Xposed 从 systemui 进程拉起（开机自启）；实际访问需悬浮窗权限 -->
        <!-- stopWithTask=false：用户上滑清除 App 任务时不停服务，配合 BeatService.onTaskRemoved 自愈，
             实现"脱离软件后光效/震动持续工作" -->
        <service
            android:name=".core.BeatService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="music-driven RGB overlay &amp; vibration" />
        </service>

        <receiver
            android:name=".core.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
