<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LSPosed 推荐 Hook 名单（作用域）：
         · com.android.systemui —— 核心自启链路（XposedInit 只在 systemui 进程拉起光效服务）
         · 打车/导航应用 —— 系统推荐 Hook 对象，LSPosed 中显示"推荐应用"并默认勾选；
           模块在这些进程内不注入逻辑（XposedInit 按包名跳过），晕车判定由系统能力完成 -->
    <string-array name="xposed_scope">
        <item>com.android.systemui</item>
        <item>com.autonavi.minimap</item>
        <item>com.baidu.BaiduMap</item>
        <item>com.tencent.map</item>
        <item>com.sdu.didi.psnger</item>
        <item>com.didi.fleet.carclient</item>
        <item>com.amap.android.rtbt</item>
        <item>com.caocao.motop</item>
        <item>com.t3go.t3go</item>
        <item>com.huaxiaozhu</item>
        <item>com.meituan.car</item>
        <item>com.zhugecars.com.cn</item>
        <item>com.shenzhou.chefu</item>
    </string-array>

    <string-array name="mode_labels">
        <item>屏幕边缘光效</item>
        <item>跑马灯流动</item>
        <item>仅键盘环绕</item>
        <item>自动切换</item>
    </string-array>
    <string-array name="mode_values">
        <item>edge</item>
        <item>marquee</item>
        <item>keyboard</item>
        <item>auto</item>
    </string-array>

    <string-array name="audio_source_labels">
        <item>自动（频谱优先，麦克风回退）</item>
        <item>仅播放器频谱</item>
        <item>仅麦克风拾音</item>
    </string-array>
    <string-array name="audio_source_values">
        <item>auto</item>
        <item>visualizer</item>
        <item>mic</item>
    </string-array>

    <!-- 粒子画质档位 -->
    <string-array name="particle_quality_labels">
        <item>高画质（3000 粒子）</item>
        <item>节电（700 粒子）</item>
    </string-array>
    <string-array name="particle_quality_values">
        <item>high</item>
        <item>eco</item>
    </string-array>

    <!-- 高潮礼物特效：与 EffectPicker.VALUES / HighlightEffectsRenderer.EFFECT_RES 顺序一致 -->
    <string-array name="highlight_effect_labels">
        <item>自动轮播（三段依次播放）</item>
        <item>星际轨道</item>
        <item>心海流光</item>
        <item>鎏金凤凰</item>
    </string-array>
    <string-array name="highlight_effect_values">
        <item>cycle</item>
        <item>orbit</item>
        <item>ocean</item>
        <item>phoenix</item>
    </string-array>

    <!-- 抠背景模式：与 EffectKeyMode.VALUES 顺序一致 -->
    <string-array name="highlight_key_labels">
        <item>自动（通吃黑/白/灰/渐变底）</item>
        <item>纯黑底素材</item>
        <item>浅色/白底素材</item>
        <item>不抠背景（原样显示，排查用）</item>
    </string-array>
    <string-array name="highlight_key_values">
        <item>auto</item>
        <item>dark</item>
        <item>light</item>
        <item>off</item>
    </string-array>

    <!-- 礼物特效统一染色：与 EffectTint.VALUES 顺序一致，默认心形粉 -->
    <string-array name="highlight_tint_labels">
        <item>白里粉（白芯透粉，默认）</item>
        <item>心形粉（玫红）</item>
        <item>玫瑰紫</item>
        <item>极光青</item>
        <item>深海蓝</item>
        <item>鎏金橙</item>
        <item>荧光绿</item>
        <item>中国红</item>
        <item>素材原色（不染色）</item>
    </string-array>
    <string-array name="highlight_tint_values">
        <item>whitepink</item>
        <item>heart</item>
        <item>violet</item>
        <item>cyan</item>
        <item>blue</item>
        <item>orange</item>
        <item>green</item>
        <item>red</item>
        <item>none</item>
    </string-array>

    <!-- 数据源模式：融合 / 音乐律动 / 晕车缓解 -->
    <string-array name="data_mode_labels">
        <item>融合（音乐 + 晕车缓解）</item>
        <item>音乐律动（音频频谱）</item>
        <item>晕车缓解（车辆运动）</item>
    </string-array>
    <string-array name="data_mode_values">
        <item>fusion</item>
        <item>music</item>
        <item>motion</item>
    </string-array>
</resources>
